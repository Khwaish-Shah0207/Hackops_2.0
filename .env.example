# Database Connection (Default: SQLite for zero-setup execution, or PostgreSQL with PostGIS)
DATABASE_URL=sqlite:///./enviro_compliance.db
# For PostgreSQL / PostGIS:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/enviro_compliance

# Security & JWT Token Generation
SECRET_KEY=env-compliance-super-secret-jwt-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Anomaly Detection Settings
ISOLATION_FOREST_CONTAMINATION=0.1

# Meteorological & Plume Dispersion (Optional HYSPLIT binary path)
HYSPLIT_EXECUTABLE=

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

